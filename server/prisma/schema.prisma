generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("MANAGER") // ADMIN or MANAGER
  createdAt DateTime @default(now())
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  company   String
  email     String
  phone     String
  address   String
  country   String
  rating    Float    @default(0)
  status    String   @default("Active")
  products  String   
  createdAt DateTime @default(now())
  
  shipments Shipment[]
  inventory Inventory[]
}

model Warehouse {
  id              String   @id @default(uuid())
  name            String
  location        String
  capacity        Int
  usedCapacity    Int      @default(0)
  managerName     String
  contactNumber   String
  createdAt       DateTime @default(now())

  shipments       Shipment[]
  inventory       Inventory[]
}

model Inventory {
  id          String   @id @default(uuid())
  productName String
  sku         String   @unique
  category    String
  quantity    Int
  minStock    Int
  unitPrice   Float
  
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  
  supplierId  String
  supplier    Supplier  @relation(fields: [supplierId], references: [id])

  createdAt   DateTime @default(now())
}

model Shipment {
  id              String   @id @default(uuid())
  trackingId      String   @unique
  destination     String
  shipmentDate    DateTime
  expectedDelivery DateTime
  actualDelivery  DateTime?
  status          String   
  priority        String   
  shippingCost    Float

  supplierId      String
  supplier        Supplier @relation(fields: [supplierId], references: [id])

  warehouseId     String
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id])

  createdAt       DateTime @default(now())
}
